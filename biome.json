{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": ["src/**", "scripts/**", "!src/routeTree.gen.ts"]
  },
  "formatter": {
    "enabled": false
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "preset": "recommended"
      },
      "suspicious": {
        "preset": "recommended",
        "noAssignInExpressions": "off",
        "noControlCharactersInRegex": "off"
      }
    }
  }
}
