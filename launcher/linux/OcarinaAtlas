#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"

NODE_BIN="$SCRIPT_DIR/runtime/node"
CLI_ENTRY="$SCRIPT_DIR/app/ocarina-atlas-cli.mjs"

if [ ! -x "$NODE_BIN" ]; then
  echo "ERROR: Bundled Node.js runtime not found or not executable at: $NODE_BIN" >&2
  exit 1
fi

if [ ! -f "$CLI_ENTRY" ]; then
  echo "ERROR: Ocarina Atlas CLI entrypoint not found at: $CLI_ENTRY" >&2
  exit 1
fi

exec "$NODE_BIN" "$CLI_ENTRY" "$@"
