# Freedesktop desktop entry template for Ocarina Atlas
# Replace /path/to/OcarinaAtlas-Linux-x64 with your extracted folder path,
# or use "Install Desktop Shortcut" inside the Ocarina Atlas GUI Settings tab.
[Desktop Entry]
Type=Application
Name=Ocarina Atlas
Comment=Interactive 3D map & live telemetry tracker for Ocarina of Time Remake
Exec=/path/to/OcarinaAtlas-Linux-x64/OcarinaAtlas
Icon=/path/to/OcarinaAtlas-Linux-x64/icon.png
Terminal=false
Categories=Game;Utility;
StartupWMClass=OcarinaAtlas
